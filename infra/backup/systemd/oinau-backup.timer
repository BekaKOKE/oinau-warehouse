[Unit]
Description=OINAU PRO: ежедневная резервная копия PostgreSQL

[Timer]
; 03:20 по времени сервера — вне рабочих часов и не «ровно в 03:00»,
; когда просыпаются все остальные задачи.
OnCalendar=*-*-* 03:20:00
; Если сервер был выключен в момент запуска — снять копию при включении.
Persistent=true
; Небольшой разброс, чтобы несколько серверов не стартовали синхронно.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
