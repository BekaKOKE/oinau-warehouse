# Обратный прокси production-окружения.
#
# Одна точка входа на весь проект:
#   /api/*   -> backend  (FastAPI)
#   /admin*  -> admin    (Next.js, basePath=/admin)
#   всё остальное -> web (Next.js, витрина)
#
# API живёт на ТОМ ЖЕ origin, что и витрина. Это не случайность:
#   * cookie refresh-токена (path=/api/v1/admin/auth, SameSite=strict)
#     работает без послаблений;
#   * браузер не делает preflight на каждый запрос;
#   * отдельный домен api.* не нужно ни выпускать, ни продлевать.
#
# Редирект 80 -> 443 и выпуск сертификата Caddy делает сам.
{
	email {$ACME_EMAIL}
	# Админский API Caddy слушает только localhost внутри контейнера —
	# наружу он не проброшен. Используется healthcheck-ом контейнера.
	admin 127.0.0.1:2019
	# trusted_proxies здесь НАМЕРЕННО не задан. Настоящий адрес клиента
	# вычисляет backend (TRUSTED_PROXY_HOPS): он считает записи
	# X-Forwarded-For справа, а Caddy в любом случае дописывает адрес
	# своего peer-а в конец цепочки. Список доверенных адресов в прокси
	# при такой схеме ничего не добавляет, а разойтись с backend может.
}

# ---------------------------------------------------------------- www -> apex
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Заголовки безопасности задаются ОТДЕЛЬНЫМИ директивами, а не одним
	# блоком. Внутри общего блока «?» (поставить, если приложение не
	# поставило своего) работает на весь блок разом: стоит upstream
	# прислать хотя бы один из перечисленных заголовков — и не добавится
	# ни один. Админка на Next присылает свой X-Frame-Options, и в блочной
	# записи её страницы остались бы вообще без HSTS.
	#
	# Единые для всего сайта значения ставятся безусловно. Префикс «>»
	# откладывает операцию до момента записи ответа: без него заголовок
	# ставится ДО ответа upstream, и собственный заголовок приложения
	# добавляется вторым значением — браузер получает два разных HSTS.
	header >Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header >X-Content-Type-Options "nosniff"
	header >Permissions-Policy "geolocation=(), microphone=(), camera=()"
	# А эти — только как запасной вариант: у админки и API они строже
	# (DENY, same-origin), и перекрывать их значит ослаблять защиту.
	header ?X-Frame-Options "SAMEORIGIN"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	# Версию прокси наружу не показываем.
	header -Server

	request_body {
		max_size {$MAX_BODY_SIZE}
	}

	# ------------------------------------------------------------- health
	# Наружу отдаётся только liveness: он не ходит в зависимости и не
	# раскрывает их состояние. /health/ready показывает, что именно
	# сломано (БД, Redis, хранилище), — это диагностика для нас,
	# а не для посторонних. Смотреть её на сервере:
	#   docker compose ... exec backend curl -s localhost:8000/health/ready
	handle /health/* {
		respond 404
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# ---------------------------------------------------------------- API
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			# Разбор и применение XLSX — самая долгая операция админки.
			# Ограничено только ожидание ЗАГОЛОВКОВ ответа, и с запасом:
			# оборвать импорт на середине хуже, чем подождать. Общего
			# потолка на запрос у Caddy по умолчанию нет — и это здесь
			# правильно, менять не нужно.
			transport http {
				dial_timeout 5s
				response_header_timeout 300s
			}
		}
	}

	# ------------------------------------------------------------- админка
	# Точное совпадение и всё, что ниже: /administrator сюда НЕ попадёт.
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin:3000
	}

	# ------------------------------------------------------------- витрина
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
