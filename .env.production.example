# =============================================================================
# OINAU-PRO — шаблон ПРОДАКШН-окружения
#
# На сервере:  cp .env.production.example .env.production  и заполнить.
# Файл .env.production в .gitignore. Реальные значения в репозиторий
# не попадают НИКОГДА — ни в этот файл, ни в compose, ни в Dockerfile.
#
# Права на сервере:  chmod 600 .env.production  (владелец — пользователь,
# от имени которого работает docker compose).
#
# Все значения ниже — ЗАГЛУШКИ. Строки с пометкой «ЗАПОЛНИТЬ» обязательны:
# без них backend не стартует, а падает на валидации конфигурации.
# Это сделано намеренно — лучше отказ при старте, чем тихо работающий
# продакшн с dev-настройками.
# =============================================================================

# ------------------------------------------------------------------ окружение
ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
PROJECT_NAME=OINAU-PRO API

DEFAULT_REGION_CODE=almaty
DEFAULT_CURRENCY=KZT
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru

# --------------------------------------------------------------- домен и сеть
# Домен обслуживает Caddy: HTTP -> HTTPS и выпуск сертификата автоматически.
SITE_DOMAIN=oinau-pro.kz
# Адрес для уведомлений Let's Encrypt об истечении сертификата. ЗАПОЛНИТЬ.
ACME_EMAIL=admin@oinau-pro.kz
# Потолок тела запроса на прокси. Изображения браузер кладёт в R2 напрямую
# по presigned URL, через API идут XLSX-импорт (UPLOAD_MAX_SIZE_MB=15) и
# файл к запросу КП (REQUEST_ATTACHMENT_MAX_SIZE_MB=20).
#
# Запас обязателен, и его мало не бывает: Caddy считает «MB» как 10^6,
# то есть 20MB здесь — это 20 000 000 байт, тогда как 20 МиБ вложения —
# 20 971 520 байт плюс заголовки multipart. С потолком 20MB прокси
# отрезал бы файл раньше backend, и клиент получил бы голый 413 вместо
# понятного ответа приложения.
MAX_BODY_SIZE=25MB
# Сколько процессов uvicorn. Ориентир: по числу ядер VPS, минимум 2.
UVICORN_WORKERS=4

# ------------------------------------------------------------------ PostgreSQL
# Контейнер postgres не имеет проброшенных портов: база доступна только
# из внутренней сети Docker. Хост подставляет compose (postgres).
POSTGRES_USER=oinau
# ЗАПОЛНИТЬ. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=ЗАПОЛНИТЬ-сгенерированным-паролем
POSTGRES_DB=oinau
DB_ECHO=false
# Пул на КАЖДЫЙ процесс uvicorn. 4 процесса x (10 + 20) упрутся в
# max_connections=100 у PostgreSQL — при увеличении числа процессов
# уменьшайте пул или поднимайте max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------- Redis
# Тоже без проброшенных портов и без пароля: сеть internal изолирована,
# и доступ к ней есть только у backend и воркера.
REDIS_DB=0

# ------------------------------------------------------- Cloudflare R2 (медиа)
# Бакет создаётся в панели Cloudflare -> R2. Ключ выдаётся там же
# (R2 -> Manage API tokens), права — Object Read & Write на ОДИН бакет.
# ЗАПОЛНИТЬ все четыре строки.
S3_ENDPOINT_URL=https://ЗАПОЛНИТЬ-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=ЗАПОЛНИТЬ
S3_SECRET_ACCESS_KEY=ЗАПОЛНИТЬ
S3_BUCKET=oinau-media
# У R2 адрес подписи совпадает с основным — оставить пустым.
S3_PUBLIC_ENDPOINT_URL=
# Публичный домен медиа (Cloudflare R2 -> Settings -> Public access ->
# Connect a custom domain). Из него собираются URL картинок товаров.
# ВАЖНО: этот же адрес нужно передать в NEXT_PUBLIC_CDN_BASE_URL ниже,
# иначе Next.js откажется отдавать изображения с чужого хоста.
CDN_BASE_URL=https://cdn.oinau-pro.kz
UPLOAD_MAX_SIZE_MB=15
UPLOAD_PRESIGN_TTL_SECONDS=600
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
UPLOAD_MAX_IMAGE_PIXELS=50000000

IMPORT_MAX_UNCOMPRESSED_MB=100
IMPORT_MAX_ROWS_PER_SHEET=20000
IMPORT_PREVIEW_TTL_HOURS=24

# Схемы и чертежи товаров в медиатеке (PDF, DWG, DXF) — свой список и лимит.
UPLOAD_ALLOWED_DOCUMENT_MIME=application/pdf,image/vnd.dwg,image/vnd.dxf
UPLOAD_MAX_DOCUMENT_SIZE_MB=50

# Массовый импорт товаров (ZIP: products.xlsx + photos/ + schemes/).
# Архив идёт браузером прямо в хранилище (presigned PUT), мимо лимита прокси.
IMPORT_BUNDLE_MAX_MB=1024
IMPORT_BUNDLE_MAX_UNCOMPRESSED_MB=3072   # защита от ZIP-бомбы
IMPORT_BUNDLE_MAX_FILES=5000
IMPORT_BUNDLE_MAX_RATIO=100              # степень сжатия одного файла
IMPORT_BUNDLE_INLINE=false

# -------------------------------------------------------------------- Security
# ЗАПОЛНИТЬ. Сгенерировать: openssl rand -hex 32
# Смена ключа разлогинивает всех: и сотрудников, и клиентов кабинета.
SECRET_KEY=ЗАПОЛНИТЬ-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
CUSTOMER_REFRESH_TOKEN_TTL_DAYS=30
CUSTOMER_EMAIL_VERIFICATION_TTL_HOURS=24
CUSTOMER_PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Витрина, админка и API живут на ОДНОМ origin (админка — по пути /admin,
# API — по пути /api). Поэтому в списке ровно один адрес, и он https:
# пустой список, "*" и http в production отклоняются при старте.
CORS_ORIGINS=https://oinau-pro.kz

# Secure включается автоматически и отключить его в production нельзя.
# SameSite=strict работает, потому что всё на одном домене.
COOKIE_SAMESITE=strict
# COOKIE_SECURE=            # пусто = auto (true в production)
# COOKIE_DOMAIN=            # пусто = cookie привязана к домену сайта

# Число ОБРАТНЫХ ПРОКСИ перед backend. Считаются те, что дописывают
# X-Forwarded-For: Cloudflare + Caddy = 2. Если Cloudflare переведён
# в режим «DNS only» (серое облако), остаётся только Caddy — значение 1.
# Ошибка в большую сторону позволяет подделать адрес клиента, в меньшую —
# весь трафик считается одним клиентом и упирается в ограничение частоты.
TRUSTED_PROXY_HOPS=2

# IP системы 1С. Пустое значение отключает проверку адреса — в production
# так оставлять нельзя, если обмен включён.
INTEGRATION_IP_ALLOWLIST=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_FORM=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_MEDIA_UPLOAD=60/minute
RATE_LIMIT_CATALOG_IMPORT=30/minute
RATE_LIMIT_CUSTOMER_REGISTER=5/hour
RATE_LIMIT_CUSTOMER_LOGIN=10/minute
RATE_LIMIT_CUSTOMER_EMAIL=5/hour
RATE_LIMIT_CUSTOMER_EMAIL_PER_ADDRESS=3/hour
RATE_LIMIT_CUSTOMER_TOKEN=20/hour
RATE_LIMIT_INTEGRATION=120/minute

# ---------------------------------------------------------------- уведомления
NOTIFICATIONS_ENABLED=true
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_SECONDS=60

# --- почта -------------------------------------------------------------
# ЗАПОЛНИТЬ реквизитами почтового сервиса. Значение mailpit/localhost
# в production отклоняется при старте: это локальный перехватчик,
# из него письма клиентам не уходят.
SMTP_HOST=ЗАПОЛНИТЬ-smtp.example.kz
SMTP_PORT=587
SMTP_USER=noreply@oinau-pro.kz
SMTP_PASSWORD=ЗАПОЛНИТЬ
SMTP_TLS=true                       # STARTTLS на 587
SMTP_SSL=false                      # неявный TLS на 465; вместе с SMTP_TLS не задают
SMTP_FROM=noreply@oinau-pro.kz
SMTP_FROM_NAME=OINAU PRO
SMTP_TIMEOUT_SECONDS=15
# Кому уходят деловые письма о новых заявках (через запятую).
# ЗАПОЛНИТЬ рабочими адресами: пустое значение = деловые письма не
# отправляются вообще (событие даже не попадает в очередь), а
# несуществующий адрес = молча потерянные заявки.
NOTIFY_EMAILS=sales@oinau-pro.kz

# --- Telegram ----------------------------------------------------------
# Токен от @BotFather. Равносилен паролю от рассылки: в логи не попадает
# (логгер httpx приглушён приложением), в админке не отображается.
# Пусто = канал выключен, события помечаются skipped.
TELEGRAM_BOT_TOKEN=
# id супергруппы (отрицательный, вида -1001234567890). Можно несколько
# через запятую.
TELEGRAM_CHAT_ID=
# Тема внутри форумной супергруппы: message_thread_id (положительное
# число). Пусто = общий поток чата. Значение применяется ко ВСЕМ чатам
# списка выше, а темы понимает только супергруппа с включёнными темами.
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10

# Адреса для ссылок в письмах и уведомлениях. Оба обязаны быть https
# и не локальными — иначе backend не стартует.
PUBLIC_SITE_URL=https://oinau-pro.kz
PUBLIC_ADMIN_URL=https://oinau-pro.kz/admin

# ------------------------------------------------------------- обмен с 1С
# Включать ТОЛЬКО после сверки контракта с конкретной конфигурацией 1С
# (docs/integrations.md). При false эндпоинты обмена отвечают 503.
ONE_C_INTEGRATION_ENABLED=false
INTEGRATION_MAX_BATCH_ITEMS=1000
INTEGRATION_MAX_BODY_BYTES=5000000

# Пусто = отправка ошибок в Sentry выключена.
SENTRY_DSN=

# =============================================================================
# Frontend
#
# ВНИМАНИЕ: NEXT_PUBLIC_* встраиваются в браузерный бандл НА ЭТАПЕ СБОРКИ
# образа. Секретов среди них быть не может, а изменение любого из них
# требует ПЕРЕСБОРКИ образов web/admin, а не только перезапуска.
# =============================================================================

# API на том же домене: браузер ходит на https://oinau-pro.kz/api/v1/...
NEXT_PUBLIC_API_URL=https://oinau-pro.kz
# Канонический адрес сайта: sitemap.xml, canonical, OpenGraph.
NEXT_PUBLIC_SITE_URL=https://oinau-pro.kz
# Тот же адрес, что и CDN_BASE_URL выше. Хост попадает в
# images.remotePatterns — без него Next.js не отдаст картинки товаров.
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.oinau-pro.kz

# Запасные значения плавающей кнопки WhatsApp: используются, пока
# раздел «Контакты» в админке не заполнен.
NEXT_PUBLIC_WHATSAPP_NUMBER=+77270000000
NEXT_PUBLIC_WHATSAPP_MESSAGE=Здравствуйте! Пишу с сайта OINAU PRO.

# =============================================================================
# Резервные копии (используются infra/backup/pg-backup.sh)
# =============================================================================
# Куда складывать дампы НА СЕРВЕРЕ. Каталог должен лежать вне тома
# PostgreSQL: копия внутри тома не переживёт его потерю.
BACKUP_DIR=/var/backups/oinau
# Сколько дней хранить. Старые файлы удаляются после успешного дампа.
BACKUP_RETENTION_DAYS=14
# Необязательно: remote rclone для копии ВНЕ сервера (R2, S3, любой).
# Пусто = копии остаются только на диске VPS, и потеря сервера означает
# потерю резервных копий вместе с ним.
BACKUP_REMOTE=
