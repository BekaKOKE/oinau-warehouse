# =============================================================================
# OINAU-PRO — пример переменных окружения
#
# Скопировать: cp .env.example .env
# Файл .env в .gitignore. Реальные секреты в репозиторий не попадают НИКОГДА.
# Прод-секреты хранятся в секретах CI/CD и на сервере, не в файлах разработчиков.
#
# Значения ниже рассчитаны на локальный запуск через Docker Compose
# (make setup). Если PostgreSQL/Redis/MinIO подняты не в Docker, замените
# POSTGRES_HOST, REDIS_HOST и S3_ENDPOINT_URL на localhost — см. README,
# раздел «Запуск без Docker».
# =============================================================================

# ------------------------------------------------------------------ окружение
ENV=local                       # local | ci | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console              # console локально, json в проде
PROJECT_NAME=OINAU-PRO API

DEFAULT_REGION_CODE=almaty      # текущий регион работы; не хардкод в коде
DEFAULT_CURRENCY=KZT
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru            # добавить kk можно без миграции схемы

# ------------------------------------------------------------------ PostgreSQL
POSTGRES_HOST=postgres          # localhost при запуске backend вне Docker
POSTGRES_PORT=5432
POSTGRES_USER=oinau
POSTGRES_PASSWORD=oinau         # ЗАМЕНИТЬ в staging/production
POSTGRES_DB=oinau
POSTGRES_PORT_HOST=5432         # порт, проброшенный на хост разработчика
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------- Redis
REDIS_HOST=redis                # localhost при запуске backend вне Docker
REDIS_PORT=6379
REDIS_DB=0
REDIS_PORT_HOST=6379

# ----------------------------------------- Object storage (MinIO / Cloudflare R2)
# Локально — MinIO. В проде — R2:
#   S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   CDN_BASE_URL=https://cdn.oinau-pro.kz
S3_ENDPOINT_URL=http://minio:9000   # http://localhost:9000 вне Docker
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=oinau-media
# Адрес для подписи presigned URL (их открывает браузер). Пусто = S3_ENDPOINT_URL,
# так для R2. Локально backend ходит в minio:9000, а браузеру нужен localhost:9000.
# Для R2 на бакете нужна CORS-политика: PUT с origin админки, заголовок Content-Type.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Из этого адреса собираются ссылки на изображения товаров. Хост обязан быть
# в images.remotePatterns (apps/web/next.config.ts), иначе Next.js их не отдаст.
CDN_BASE_URL=http://localhost:9000/oinau-media
UPLOAD_MAX_SIZE_MB=15
UPLOAD_PRESIGN_TTL_SECONDS=600
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
UPLOAD_MAX_IMAGE_PIXELS=50000000   # защита воркера от «декомпрессионной бомбы»

# Excel-импорт каталога. Размер файла ограничен UPLOAD_MAX_SIZE_MB.
IMPORT_MAX_UNCOMPRESSED_MB=100     # XLSX — это ZIP: защита от «ZIP-бомбы»
IMPORT_MAX_ROWS_PER_SHEET=20000
IMPORT_PREVIEW_TTL_HOURS=24        # сколько живёт предпросмотр до подтверждения

# Схемы и чертежи товаров в медиатеке (PDF, DWG, DXF) — свой список и лимит.
UPLOAD_ALLOWED_DOCUMENT_MIME=application/pdf,image/vnd.dwg,image/vnd.dxf
UPLOAD_MAX_DOCUMENT_SIZE_MB=50

# Массовый импорт товаров (ZIP: products.xlsx + photos/ + schemes/).
# Архив идёт браузером прямо в хранилище (presigned PUT), мимо лимита прокси.
IMPORT_BUNDLE_MAX_MB=1024
IMPORT_BUNDLE_MAX_UNCOMPRESSED_MB=3072   # защита от ZIP-бомбы
IMPORT_BUNDLE_MAX_FILES=5000
IMPORT_BUNDLE_MAX_RATIO=100              # степень сжатия одного файла
IMPORT_BUNDLE_INLINE=false                # true — проверка и применение без воркера (локально)

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT_HOST=9000               # S3 API
MINIO_CONSOLE_PORT_HOST=9001       # веб-интерфейс MinIO

# -------------------------------------------------------------------- Security
# Сгенерировать: openssl rand -hex 32 (минимум 32 символа, проверяется при старте)
SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Локально — порты dev-серверов. В production допустимы ТОЛЬКО https-origin,
# список проверяется при старте (пустой список и "*" отклоняются):
#   CORS_ORIGINS=https://oinau-pro.kz,https://admin.oinau-pro.kz
# Без верного значения браузер не даст витрине отправить заявку.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookie с refresh-токеном. В production Secure включается автоматически
# и не может быть отключён. SameSite=strict работает, потому что
# oinau-pro.kz и admin.oinau-pro.kz — один сайт.
COOKIE_SAMESITE=strict
# COOKIE_SECURE=            # пусто = auto (true в production)
# COOKIE_DOMAIN=            # пусто = cookie привязана к домену API

# Число ОБРАТНЫХ ПРОКСИ перед приложением. 0 = X-Forwarded-For игнорируется.
# Пока значение 0, заголовок не влияет ни на ограничение частоты, ни на аудит,
# и подделать источник запроса нельзя. В production обязательно выставить
# фактическое число: nginx -> 1, Cloudflare + nginx -> 2.
TRUSTED_PROXY_HOPS=0

# IP системы 1С. Пусто = проверка IP отключена (только для local).
# Комментарий вынесен на отдельную строку: в строке с пустым значением
# он стал бы частью значения.
INTEGRATION_IP_ALLOWLIST=

# Ограничение частоты требует Redis. Если Redis недоступен, проверка
# пропускается (запросы не блокируются), а в лог пишется предупреждение.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_FORM=5/hour       # заявки с одного IP; для отладки формы поднимите
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_MEDIA_UPLOAD=60/minute   # выдача presigned URL в админке
RATE_LIMIT_CATALOG_IMPORT=30/minute # предпросмотр и подтверждение Excel-импорта
# Обмен с 1С считается НА КЛЮЧ, а не на IP: 1С обычно стоит за общим
# корпоративным NAT, и лимит по адресу ограничивал бы весь офис.
RATE_LIMIT_INTEGRATION=120/minute

# ---------------------------------------------------------------- уведомления
# Общий выключатель. false = ни один канал не отправляет, но события
# всё равно копятся в notification_outbox и помечаются пропущенными.
# Нужен на staging с боевыми реквизитами: там письма живым клиентам
# уходить не должны.
NOTIFICATIONS_ENABLED=true
# Сколько раз воркер пробует доставить событие, прежде чем признать
# его неудачным. Пауза между попытками растёт экспоненциально.
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_SECONDS=60

# --- почта -------------------------------------------------------------
# Локально письма ловит Mailpit: http://localhost:8025 (логин не нужен).
# Канал считается настроенным при заданных SMTP_HOST и SMTP_FROM.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false                      # STARTTLS на открытом порту (обычно 587)
SMTP_SSL=false                      # неявный TLS (обычно 465); вместе с SMTP_TLS не задают
SMTP_FROM=noreply@oinau-pro.kz
SMTP_FROM_NAME=OINAU PRO
SMTP_TIMEOUT_SECONDS=15
# Кому уходят ДЕЛОВЫЕ уведомления о новых заявках (через запятую).
# Пусто = деловые письма не отправляются; письма клиентам это не отключает.
NOTIFY_EMAILS=

# --- Telegram ----------------------------------------------------------
# Токен бота от @BotFather. Пусто = канал отключён.
# ВАЖНО: токен равносилен паролю от рассылки. Он стоит в пути URL Bot API,
# поэтому логгер httpx приглушён приложением — иначе токен попал бы в журнал.
TELEGRAM_BOT_TOKEN=
# Один чат или несколько через запятую: -1001234567890,123456789.
# Узнать id чата: добавить бота в чат и вызвать getUpdates.
TELEGRAM_CHAT_ID=
# Тема («топик») форумной супергруппы — message_thread_id из getUpdates.
# Пусто = сообщения уходят в общий поток чата.
# ВНИМАНИЕ: значение применяется ко ВСЕМ чатам из TELEGRAM_CHAT_ID, а темы
# понимают только супергруппы с включёнными темами. Обычная группа или
# личка на тот же запрос ответят «message thread not found».
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10

# Адрес витрины для ссылок в письмах клиенту: подтверждение адреса,
# сброс пароля, «посмотреть заявку». Без правильного значения ссылки
# в письмах ведут в никуда.
PUBLIC_SITE_URL=http://localhost:3000
# Адрес админки для ссылок «открыть заявку» в деловых уведомлениях.
PUBLIC_ADMIN_URL=http://localhost:3001/admin

# ------------------------------------------------------------- обмен с 1С
# Выключатель обмена. false = эндпоинты /api/v1/integration отвечают 503
# даже с верным ключом: ключ можно завести заранее, а обмен включить позже.
#
# ВНИМАНИЕ: включать боевой обмен можно только после сверки контракта
# с выгрузкой конкретной конфигурации 1С — см. docs/integrations.md.
ONE_C_INTEGRATION_ENABLED=false
# Позиций в одном пакете и потолок размера тела запроса.
INTEGRATION_MAX_BATCH_ITEMS=1000
INTEGRATION_MAX_BODY_BYTES=5000000

SENTRY_DSN=

# =============================================================================
# Frontend
#
# ВНИМАНИЕ: всё, что начинается с NEXT_PUBLIC_, попадает в браузерный бандл.
# Секретов среди этих переменных быть не может ни при каких условиях.
# =============================================================================

# Адрес API для запросов ИЗ БРАУЗЕРА. Всегда адрес, видимый с машины
# разработчика, даже если backend работает в Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Адрес API для запросов С СЕРВЕРА Next.js. В Docker контейнер web не видит
# localhost хоста, зато видит backend по имени сервиса.
# Вне Docker задайте http://localhost:8000.
API_INTERNAL_URL=http://backend:8000

# Канонический адрес сайта: из него строятся ссылки в sitemap.xml,
# canonical и OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Запасные значения плавающей кнопки WhatsApp. Если раздел «Контакты»
# заполнен в админке, ссылка берётся оттуда, а эти значения не используются.
NEXT_PUBLIC_WHATSAPP_NUMBER=+77270000000
NEXT_PUBLIC_WHATSAPP_MESSAGE=Здравствуйте! Пишу с сайта OINAU PRO.

# Порты локальных сервисов
WEB_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=8000
